---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Projetos from '../components/Projetos.astro';
import Detalhes from '../components/Detalhes.astro';
import Simulador from '../components/Simulador.astro';
import Contato from '../components/Contato.astro';
import Rodape from '../components/Rodape.astro';
import BarraMovel from '../components/BarraMovel.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Base
  titulo="Nova Era Móveis Planejados | Móveis sob medida em Três Lagoas – MS"
  descricao="Móveis planejados para cozinhas, salas, dormitórios, áreas gourmet e banheiros em Três Lagoas – MS. Veja ambientes do portfólio da Nova Era e peça seu orçamento pelo WhatsApp."
>
  <Cabecalho />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Projetos />
    <Detalhes />
    <Simulador />
    <Contato />
  </main>
  <Rodape />
  <BarraMovel />
  <Lightbox />
</Base>

<script>
  import '../scripts/app';
</script>
