---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { empresa, mensagemPadrao, navegacao } from '../data/empresa';

const ano = new Date().getFullYear();
---

<footer class="rodape escuro" data-tema="escuro">
  <div class="container">
    <a class="rodape__chamada" href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener">
      <span class="titulo">Vamos planejar <em>o seu espaço?</em></span>
      <Icone nome="seta-diagonal" />
    </a>

    <div class="grade rodape__grade">
      <div class="rodape__selo">
        <Logo versao="selo" />
      </div>
      <p class="rodape__frase">{empresa.frase}</p>

      <nav class="rodape__nav" aria-label="Rodapé">
        <p class="rotulo">Navegação</p>
        <ul>
          <li><a href="#nova-era">A {empresa.nomeCurto}</a></li>
          {navegacao.map((item) => (
            <li>
              <a href={item.href}>{item.rotulo}</a>
            </li>
          ))}
          <li><a href="#contato">Contato</a></li>
        </ul>
      </nav>

      <div class="rodape__contato">
        <p class="rotulo">Contato</p>
        <ul>
          <li>
            <a href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener">WhatsApp {empresa.telefone.exibicao}</a>
          </li>
          <li>
            <a href={empresa.telefone.link}>Telefone {empresa.telefone.exibicao}</a>
          </li>
          <li>
            <a href={empresa.instagram.link} target="_blank" rel="noopener">{empresa.instagram.usuario}</a>
          </li>
        </ul>
      </div>

      <address class="rodape__endereco">
        <p class="rotulo">Endereço</p>
        {empresa.endereco.rua}<br />
        {empresa.endereco.bairro}, {empresa.endereco.cidade} – {empresa.endereco.uf}<br />
        CEP {empresa.endereco.cep}
      </address>
    </div>

    <div class="rodape__base">
      <p>© {ano} {empresa.nome}.</p>
      <!-- Só aparece para quem tem "menos movimento" ligado no sistema: permite ver as animações mesmo assim. -->
      <button class="rodape__movimento" type="button" data-movimento hidden></button>
      <a class="link-seta" href="#inicio" data-dir="cima">
        <span>Voltar ao topo</span>
        <Icone nome="seta-cima" />
      </a>
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-block: clamp(80px, 10vw, 176px) max(28px, env(safe-area-inset-bottom));
  }
  .rodape__chamada {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: clamp(32px, 4vw, 64px);
    border-bottom: 1px solid var(--linha-clara);
  }
  .rodape__chamada :global(svg) {
    flex: none;
    width: clamp(36px, 5vw, 84px);
    height: clamp(36px, 5vw, 84px);
    stroke-width: 1;
    color: var(--luz);
    transition: transform 620ms var(--ease-out);
  }
  @media (hover: hover) {
    .rodape__chamada:hover :global(svg) {
      transform: translate(6px, -6px);
    }
  }

  .rodape__grade {
    row-gap: 40px;
    padding-top: clamp(40px, 5vw, 80px);
  }
  .rodape__selo {
    grid-column: 1 / span 1;
    width: clamp(84px, 7vw, 116px);
  }
  .rodape__frase {
    grid-column: 3 / span 3;
    max-width: 16em;
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .rodape :global(.rotulo) {
    margin-bottom: 14px;
  }
  .rodape__nav {
    grid-column: 7 / span 2;
  }
  .rodape__contato {
    grid-column: 9 / span 2;
  }
  .rodape__endereco {
    grid-column: 11 / span 2;
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .rodape__nav a,
  .rodape__contato a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.9375rem;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 6px) / 0 1px no-repeat;
    transition:
      background-size var(--t-ui) var(--ease-out),
      color var(--t-micro) var(--ease-out);
  }
  @media (hover: hover) {
    .rodape__nav a:hover,
    .rodape__contato a:hover {
      background-size: 100% 1px;
      color: var(--luz);
    }
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    margin-top: clamp(40px, 5vw, 80px);
    padding-top: 14px;
    border-top: 1px solid var(--linha-clara);
    font-size: 0.8125rem;
    color: var(--aluminio);
  }
  .rodape__movimento {
    min-height: 44px;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .rodape__selo {
      grid-column: 1 / span 3;
    }
    .rodape__frase {
      grid-column: 4 / -1;
    }
    .rodape__nav {
      grid-column: 1 / span 4;
    }
    .rodape__contato {
      grid-column: 5 / span 4;
    }
    .rodape__endereco {
      grid-column: 9 / -1;
    }
  }
  @media (max-width: 639px) {
    .rodape__nav,
    .rodape__contato,
    .rodape__endereco {
      grid-column: 1 / -1;
    }
    .rodape {
      /* espaço para a barra fixa de orçamento */
      padding-bottom: calc(92px + env(safe-area-inset-bottom));
    }
  }
</style>
