---
import { Image } from 'astro:assets';
import miolo from '../assets/logo/logo-nova-era.png';
import selo from '../assets/logo/logo-nova-era-selo.png';

/*
 * Logo oficial da Nova Era, sem redesenho (versões geradas por scripts/preparar-logo.py
 * a partir do arquivo enviado pela empresa, pasta logo/):
 *   miolo  monograma + nome sobre o branco original. Em fundos claros a imagem é
 *          "multiplicada" sobre o fundo, para o branco do arquivo sumir sem recorte.
 *   selo   o selo circular inteiro, para fundos escuros e fotos.
 */
interface Props {
  versao?: 'miolo' | 'selo';
  class?: string;
  /** o selo também aparece no topo da página: lá ele não pode esperar a rolagem */
  imediato?: boolean;
}
const { versao = 'miolo', class: classe, imediato = false } = Astro.props;
---

{
  versao === 'selo' ? (
    <Image
      class:list={['logo-selo', classe]}
      src={selo}
      alt="Nova Era Móveis Planejados"
      widths={[120, 240, 480]}
      sizes={imediato ? '64px' : '200px'}
      format="webp"
      quality={90}
      loading={imediato ? 'eager' : 'lazy'}
    />
  ) : (
    <Image
      class:list={['logo-miolo', classe]}
      src={miolo}
      alt="Nova Era Móveis Planejados"
      widths={[200, 400]}
      sizes="200px"
      format="webp"
      quality={90}
      loading={imediato ? 'eager' : 'lazy'}
    />
  )
}

<style>
  .logo-miolo {
    display: block;
    width: auto;
    height: 52px;
    mix-blend-mode: multiply;
  }
  @media (max-width: 767px) {
    .logo-miolo {
      height: 40px;
    }
  }
  .logo-selo {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
