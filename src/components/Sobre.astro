---
import { empresa } from '../data/empresa';
---

<!-- A frase é a da própria empresa (bio do Instagram). -->
<section class="manifesto escuro" id="nova-era" aria-labelledby="sobre-titulo" data-tema="escuro">
  <div class="container">
    <h2 id="sobre-titulo" class="manifesto__frase" data-frase>{empresa.frase}</h2>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    z-index: 2;
    padding-block: var(--secao);
    /* em cima, a linha de luz; embaixo, 1 px da própria cor cobre a emenda com os projetos (escala de 125%) */
    box-shadow:
      0 -1px 0 rgb(239 197 142 / 0.5),
      0 1px 0 var(--noite);
  }
  .manifesto__frase {
    max-width: 17em;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.2rem, 0.8rem + 4.6vw, 6.5rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
</style>
