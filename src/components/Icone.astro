---
// Ícones de traço fino (1.5px), desenhados para o mesmo peso visual.
interface Props {
  nome: 'seta' | 'seta-baixo' | 'seta-cima' | 'seta-diagonal' | 'whatsapp' | 'instagram' | 'pin' | 'telefone' | 'fechar' | 'anterior' | 'proximo' | 'play' | 'pausa';
  class?: string;
}
const { nome, class: classe } = Astro.props;
---

<svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nome === 'seta' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {nome === 'seta-baixo' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {nome === 'seta-cima' && <path d="M12 20V5M6 11l6-6 6 6" />}
  {nome === 'seta-diagonal' && <path d="M7 17 17 7M8 7h9v9" />}
  {nome === 'anterior' && <path d="M15 5l-7 7 7 7" />}
  {nome === 'proximo' && <path d="M9 5l7 7-7 7" />}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6 6 18" />}
  {nome === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {nome === 'telefone' && (
    <path d="M7.6 3.8 5 4.3c-.8.2-1.4.9-1.3 1.8.6 7.3 6.9 13.6 14.2 14.2.9.1 1.6-.5 1.8-1.3l.5-2.6c.1-.6-.2-1.2-.8-1.4l-3-1.2c-.5-.2-1.1 0-1.4.4l-1 1.3a11 11 0 0 1-5-5l1.3-1c.4-.3.6-.9.4-1.4L9 4.6c-.2-.6-.8-.9-1.4-.8Z" />
  )}
  {nome === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="3.9" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {nome === 'whatsapp' && (
    <>
      <path d="M4.2 19.8l1.1-3.9A8.2 8.2 0 1 1 8.4 19l-4.2.8Z" />
      <path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.1-.2.3 0 .5.3.6 1 1.5 2 2 .2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5 0 .5-.2 1.2-.7 1.5-.6.4-1.5.5-2.6.1a8.4 8.4 0 0 1-4.1-3.7c-.6-1.1-.6-2.1-.1-2.8Z" fill="currentColor" stroke="none" />
    </>
  )}
  {nome === 'play' && <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" stroke="none" />}
  {nome === 'pausa' && <path d="M8.5 5.5v13M15.5 5.5v13" stroke-width="2.2" />}
</svg>
