---
import Icone from './Icone.astro';
import { empresa, enderecoCompleto, mapa, mensagemPadrao } from '../data/empresa';
import { categorias } from '../data/projetos';

// Mesmos ambientes dos projetos, mais "Outro".
const opcoes = [...categorias.map((c) => c.nome), 'Outro ambiente'];
---

<section class="contato secao" id="contato" aria-labelledby="contato-titulo" data-tema="claro">
  <div class="container grade contato__grade">
    <div class="contato__info">
      <h2 id="contato-titulo" class="titulo" data-revelar="linhas">Orçamento</h2>

      <dl class="canais" data-revelar="fade">
        <div class="canal">
          <dt>Telefone e WhatsApp</dt>
          <dd>
            <span class="canal__valor">{empresa.telefone.exibicao}</span>
            <span class="canal__acoes">
              <a class="link-seta" href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener">
                <span>WhatsApp</span>
                <Icone nome="seta-diagonal" />
              </a>
              <a class="link-seta" href={empresa.telefone.link}>
                <span>Ligar</span>
                <Icone nome="seta-diagonal" />
              </a>
            </span>
          </dd>
        </div>
        <div class="canal">
          <dt>Instagram</dt>
          <dd>
            <span class="canal__valor">{empresa.instagram.usuario}</span>
            <span class="canal__acoes">
              <a class="link-seta" href={empresa.instagram.link} target="_blank" rel="noopener">
                <span>Ver perfil</span>
                <Icone nome="seta-diagonal" />
              </a>
            </span>
          </dd>
        </div>
        <div class="canal">
          <dt>Endereço</dt>
          <dd>
            <address class="canal__valor">
              {empresa.endereco.rua} – {empresa.endereco.bairro}<br />
              {empresa.endereco.cidade} – {empresa.endereco.uf}, CEP {empresa.endereco.cep}
            </address>
            <span class="canal__acoes">
              <a class="link-seta" href={mapa.rota} target="_blank" rel="noopener">
                <span>Como chegar</span>
                <Icone nome="seta-diagonal" />
              </a>
            </span>
          </dd>
        </div>
      </dl>
    </div>

    <form class="formulario" data-formulario data-whatsapp={empresa.whatsapp.numero} data-mensagem={mensagemPadrao} novalidate data-revelar="fade">
      <div class="campo">
        <label for="f-nome">Seu nome</label>
        <input id="f-nome" name="nome" type="text" autocomplete="name" required maxlength="80" aria-describedby="f-nome-erro" />
        <p class="campo__erro" id="f-nome-erro" data-erro="nome" aria-live="polite"></p>
      </div>

      <fieldset class="campo">
        <legend>Quais ambientes?</legend>
        <div class="fichas">
          {
            opcoes.map((opcao) => (
              <label class="ficha">
                <input type="checkbox" name="ambientes" value={opcao} />
                <span>{opcao}</span>
              </label>
            ))
          }
        </div>
        <p class="campo__erro" data-erro="ambientes" aria-live="polite"></p>
      </fieldset>

      <div class="campo">
        <label for="f-bairro">Bairro ou cidade <small>(opcional)</small></label>
        <input id="f-bairro" name="bairro" type="text" autocomplete="address-level2" maxlength="80" />
      </div>

      <div class="campo">
        <label for="f-mensagem">Conte mais sobre o espaço <small>(opcional)</small></label>
        <textarea
          id="f-mensagem"
          name="mensagem"
          rows="4"
          maxlength="800"
          placeholder="Medidas aproximadas, o que precisa guardar…"></textarea>
      </div>

      <div class="formulario__envio">
        <button class="botao" type="submit">
          <Icone nome="whatsapp" />
          Enviar pelo WhatsApp
        </button>
        <p class="formulario__nota">A mensagem abre no WhatsApp. Nada fica salvo neste site.</p>
      </div>
    </form>

    <!-- O mapa do Google só é carregado se a pessoa pedir. -->
    <div class="mapa" data-mapa data-revelar="fade">
      <div class="mapa__botoes" data-mapa-capa>
        <button class="botao botao--contorno" type="button" data-mapa-carregar>Mostrar mapa</button>
        <a class="link-seta" href={mapa.abrir} target="_blank" rel="noopener">
          <span>Abrir no Google Maps</span>
          <Icone nome="seta-diagonal" />
        </a>
      </div>
      <template data-mapa-template>
        <iframe title={`Mapa: ${empresa.nome}, ${enderecoCompleto}`} src={mapa.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </template>
    </div>
  </div>
</section>

<style>
  .contato {
    position: relative;
    z-index: 2;
    background: var(--gesso);
  }
  .contato__grade {
    row-gap: clamp(48px, 6vw, 96px);
    align-items: start;
  }
  .contato__info {
    grid-column: 1 / span 6;
    display: grid;
    gap: 28px;
  }

  .canais {
    border-top: 1px solid var(--linha);
  }
  .canal {
    display: grid;
    gap: 6px;
    padding-block: 18px;
    border-bottom: 1px solid var(--linha);
  }
  .canal dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-2);
  }
  .canal dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
  }
  .canal__valor {
    font-size: 1.125rem;
    font-weight: 450;
    font-style: normal;
    line-height: 1.45;
  }
  .canal__acoes {
    display: flex;
    gap: 22px;
  }

  /* ---------- formulário ---------- */
  .formulario {
    grid-column: 8 / -1;
    display: grid;
    gap: 30px;
    padding-top: clamp(0px, 3vw, 56px);
  }
  .campo {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .campo label,
  .campo legend {
    padding: 0;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .campo legend {
    margin-bottom: 10px;
  }
  .campo small {
    font-weight: 400;
    color: var(--tinta-2);
  }
  .campo input[type='text'],
  .campo textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--linha-forte);
    border-radius: 0;
    font-size: 1.0625rem;
    transition: border-color var(--t-micro) var(--ease-out);
  }
  .campo textarea {
    resize: vertical;
    min-height: 112px;
    line-height: 1.55;
  }
  .campo input::placeholder,
  .campo textarea::placeholder {
    color: #636a7d;
  }
  .campo input[type='text']:focus,
  .campo textarea:focus {
    outline: none;
    border-bottom-color: var(--tinta);
    box-shadow: 0 1px 0 0 var(--tinta);
  }
  .campo [aria-invalid='true'] {
    border-bottom-color: var(--ponto);
  }
  .campo__erro {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #a3121a;
  }
  .campo__erro:empty {
    display: none;
  }

  .fichas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ficha {
    position: relative;
    cursor: pointer;
  }
  .ficha input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .ficha span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: inset 0 0 0 1px var(--linha-forte);
    transition:
      background-color var(--t-micro) var(--ease-out),
      color var(--t-micro) var(--ease-out),
      box-shadow var(--t-micro) var(--ease-out);
  }
  .ficha:hover span {
    box-shadow: inset 0 0 0 1px var(--tinta);
  }
  .ficha input:checked + span {
    background: var(--tinta);
    color: var(--claro);
    box-shadow: inset 0 0 0 1px var(--tinta);
  }
  .ficha input:focus-visible + span {
    outline: 2px solid var(--marinho-2);
    outline-offset: 2px;
  }

  .formulario__envio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-top: 6px;
  }
  .formulario__envio :global(.botao svg) {
    width: 20px;
    height: 20px;
  }
  .formulario__nota {
    flex: 1 1 220px;
    font-size: 0.8125rem;
    color: var(--tinta-2);
    line-height: 1.5;
  }

  /* ---------- mapa sob demanda ---------- */
  .mapa {
    grid-column: 1 / -1;
  }
  .mapa :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 1;
    min-height: 320px;
    border: 0;
  }
  .mapa__botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }

  @media (max-width: 1023px) {
    .contato__info,
    .formulario {
      grid-column: 1 / -1;
    }
    .mapa :global(iframe) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 599px) {
    .formulario__envio .botao,
    .mapa__botoes .botao {
      width: 100%;
    }
  }
</style>
