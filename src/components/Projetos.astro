---
import { Picture } from 'astro:assets';
import { categorias, indiceDe, series } from '../data/projetos';
import type { Foto, Linha } from '../data/projetos';

const filtros = categorias.filter((c) => series.some((s) => s.categoria === c.id));

const proporcao = (foto: Foto) => foto.src.width / foto.src.height;
// Parte da largura da tela ocupada por cada tipo de linha, para o navegador escolher o arquivo certo.
const larguraDaLinha: Record<Linha['largura'], number> = { inteira: 93, direita: 62, esquerda: 62, estreita: 46 };
const tamanhos = (linha: Linha, foto: Foto) => {
  const soma = linha.fotos.reduce((total, f) => total + proporcao(f), 0);
  return `(max-width: 767px) 100vw, ${Math.round((larguraDaLinha[linha.largura] * proporcao(foto)) / soma)}vw`;
};
// Os arquivos já estão na resolução real do recorte: as versões menores servem às telas que pedem menos.
const larguras = (foto: Foto) => [480, 720, 960].filter((l) => l < foto.src.width - 80).concat(foto.src.width);
---

<!-- Cada série reúne as fotos de um ambiente. Numa mesma linha as fotos têm a mesma altura e preenchem a
     largura (a proporção de cada uma define o quanto ocupa), então todas as bordas caem na grade.
     Nenhuma foto aparece mais larga, em pixels de layout, do que o próprio arquivo: por isso uma foto
     sozinha ocupa no máximo 8 colunas e a grade para em 1600 px. -->
<section class="projetos" id="projetos" aria-labelledby="projetos-titulo" data-projetos>
  <header class="projetos__cabeca escuro" data-tema="escuro">
    <div class="container">
      <h2 id="projetos-titulo" class="titulo" data-revelar="linhas">Projetos</h2>
      <div class="filtros" role="group" aria-label="Filtrar projetos por ambiente" data-revelar="fade">
        <button type="button" class="filtro" aria-pressed="true" data-filtro="todos">Todos</button>
        {filtros.map((c) => <button type="button" class="filtro" aria-pressed="false" data-filtro={c.id}>{c.nome}</button>)}
      </div>
    </div>
  </header>
  <p class="sr-only" aria-live="polite" data-filtro-status></p>

  {
    series.map((serie) => (
      <article
        class:list={['serie', { escuro: serie.tom === 'escuro' }]}
        id={`projeto-${serie.id}`}
        data-categoria={serie.categoria}
        data-tema={serie.tom}
        aria-labelledby={`titulo-${serie.id}`}
      >
        {serie.linhas.map((linha) => (
          <div class={`fileira fileira--${linha.largura}`}>
            {linha.titulo && (
              <h3 id={`titulo-${serie.id}`} class="serie__titulo" data-revelar="fade">
                {serie.titulo}
              </h3>
            )}
            <div class="fileira__fotos">
              {linha.fotos.map((foto) => (
                <figure style={`--r: ${proporcao(foto).toFixed(4)}`} data-revelar="fade">
                  <button
                    class="foto"
                    type="button"
                    data-lightbox-abrir={indiceDe(foto)}
                    data-lightbox-grupo={serie.id}
                    aria-label={`Ampliar foto: ${foto.legenda}`}
                  >
                    <Picture
                      src={foto.src}
                      alt={foto.alt}
                      widths={larguras(foto)}
                      sizes={tamanhos(linha, foto)}
                      formats={['avif']}
                      fallbackFormat="jpg"
                      quality={84}
                      loading="lazy"
                    />
                  </button>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </article>
    ))
  }
</section>

<style>
  .projetos {
    position: relative;
    z-index: 2;
  }
  /* As alturas vêm da proporção das fotos e podem terminar em fração de pixel: a sombra de 1 px, na
     cor do próprio fundo, cobre a emenda entre duas faixas. */
  .projetos__cabeca,
  .serie.escuro {
    box-shadow: 0 1px 0 var(--noite);
  }
  .projetos__cabeca {
    display: flow-root;
    padding-bottom: clamp(32px, 4vw, 64px);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 4px clamp(20px, 2.6vw, 40px);
    margin-top: clamp(24px, 3vw, 44px);
  }
  .filtro {
    position: relative;
    min-height: 44px;
    padding-block: 10px;
    font-size: var(--fs-pequeno);
    color: var(--aluminio);
    transition: color var(--t-micro) var(--ease-out);
  }
  .filtro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: var(--luz);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 460ms var(--ease-out);
  }
  .filtro:hover,
  .filtro[aria-pressed='true'] {
    color: var(--claro);
  }
  .filtro[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  .serie {
    display: grid;
    row-gap: var(--col-gap);
    padding-block: clamp(56px, 5.5vw, 104px);
    background: var(--gesso);
    box-shadow: 0 1px 0 var(--gesso);
  }
  .serie.escuro {
    background: var(--noite);
  }
  .serie[hidden] {
    display: none;
  }

  .serie__titulo {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.1rem + 1.3vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.016em;
    text-wrap: balance;
  }

  /* ---------- fileiras de fotos: sempre sobre a mesma grade de 12 colunas ---------- */
  .fileira {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .fileira__fotos {
    display: flex;
    gap: var(--col-gap);
    min-width: 0;
  }
  .fileira__fotos figure {
    flex: var(--r) 1 0;
    min-width: 0;
  }
  .fileira__fotos .foto {
    aspect-ratio: var(--r);
    cursor: zoom-in;
  }

  .fileira--inteira .fileira__fotos {
    grid-column: 1 / -1;
  }
  .fileira--inteira .serie__titulo {
    grid-column: 1 / -1;
    margin-bottom: clamp(20px, 2vw, 32px);
  }
  .fileira--direita .serie__titulo {
    grid-column: 1 / span 4;
  }
  .fileira--direita .fileira__fotos {
    grid-column: 5 / -1;
  }
  .fileira--esquerda .fileira__fotos {
    grid-column: 1 / span 8;
    grid-row: 1;
  }
  .fileira--esquerda .serie__titulo {
    grid-column: 9 / -1;
    grid-row: 1;
    padding-left: clamp(8px, 1.4vw, 24px);
  }
  .fileira--estreita .serie__titulo {
    grid-column: 1 / span 6;
  }
  .fileira--estreita .fileira__fotos {
    grid-column: 7 / -1;
  }

  /* tablet: as linhas recuadas ocupam a largura toda, com o título em cima */
  @media (max-width: 1023px) {
    .fileira--direita .serie__titulo,
    .fileira--esquerda .serie__titulo,
    .fileira--estreita .serie__titulo,
    .fileira--direita .fileira__fotos,
    .fileira--esquerda .fileira__fotos,
    .fileira--estreita .fileira__fotos {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-left: 0;
    }
    .fileira--direita .serie__titulo,
    .fileira--esquerda .serie__titulo,
    .fileira--estreita .serie__titulo {
      margin-bottom: 20px;
    }
  }

  /* celular: uma foto por vez, de borda a borda, para ver o ambiente no maior tamanho possível */
  @media (max-width: 767px) {
    .filtros {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filtros::-webkit-scrollbar {
      display: none;
    }
    .filtro {
      flex: none;
    }
    .serie {
      row-gap: 6px;
      padding-block: 44px;
    }
    .fileira {
      display: block;
      padding-inline: 0;
    }
    .serie__titulo,
    .fileira--inteira .serie__titulo,
    .fileira--direita .serie__titulo,
    .fileira--esquerda .serie__titulo,
    .fileira--estreita .serie__titulo {
      margin-bottom: 16px;
      padding-inline: var(--gutter);
    }
    .fileira__fotos {
      flex-direction: column;
      gap: 6px;
    }
    .fileira__fotos figure {
      flex: none;
    }
  }
</style>
