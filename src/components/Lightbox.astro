---
import { getImage } from 'astro:assets';
import Icone from './Icone.astro';
import { fotosAmpliaveis } from '../data/projetos';

// Versões grandes para o visualizador, na ordem de fotosAmpliaveis (os índices dos botões apontam para cá).
const ampliadas = await Promise.all(
  fotosAmpliaveis.map(async ({ foto, ambiente }) => ({
    src: (await getImage({ src: foto.src, width: foto.src.width, format: 'webp', quality: 84 })).src,
    largura: foto.src.width,
    altura: foto.src.height,
    alt: foto.alt,
    ambiente,
    legenda: foto.legenda,
  })),
);
---

<dialog class="lightbox escuro" aria-label="Foto ampliada" data-lightbox>
  <div class="lightbox__barra">
    <p class="lightbox__contador" aria-live="polite"><span data-lightbox-atual>1</span> / <span data-lightbox-total>{ampliadas.length}</span></p>
    <button class="lightbox__fechar" type="button" data-lightbox-fechar>
      <span>Fechar</span>
      <Icone nome="fechar" />
    </button>
  </div>
  <figure class="lightbox__figura">
    <img data-lightbox-img src={ampliadas[0].src} alt="" width={ampliadas[0].largura} height={ampliadas[0].altura} decoding="async" />
    <figcaption>
      <strong data-lightbox-ambiente></strong>
      <span data-lightbox-legenda></span>
    </figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--anterior" type="button" data-lightbox-anterior aria-label="Foto anterior">
    <Icone nome="anterior" />
  </button>
  <button class="lightbox__nav lightbox__nav--proximo" type="button" data-lightbox-proximo aria-label="Próxima foto">
    <Icone nome="proximo" />
  </button>
  <script type="application/json" data-lightbox-dados set:html={JSON.stringify(ampliadas)} />
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 19 38 / 0.97);
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px var(--gutter);
    min-height: var(--header-h);
  }
  .lightbox__contador {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--aluminio);
  }
  .lightbox__fechar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .lightbox__fechar :global(svg) {
    width: 22px;
    height: 22px;
  }
  .lightbox__figura {
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: 16px;
    padding: 0 clamp(16px, 9vw, 140px) clamp(16px, 3vh, 32px);
  }
  .lightbox__figura img {
    min-height: 0;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    transform-origin: 0 0;
  }
  .lightbox__figura figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    max-width: 52em;
    text-align: center;
    font-size: 0.875rem;
    color: var(--aluminio);
  }
  .lightbox__figura strong {
    font-weight: 500;
    color: var(--claro);
  }
  .lightbox__nav {
    position: fixed;
    top: 50%;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-top: -28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--linha-clara);
    transition: background-color var(--t-micro) var(--ease-out);
  }
  .lightbox__nav:hover {
    background: rgb(244 243 239 / 0.08);
  }
  .lightbox__nav[hidden] {
    display: none;
  }
  .lightbox__nav :global(svg) {
    width: 22px;
    height: 22px;
  }
  .lightbox__nav--anterior {
    left: clamp(12px, 2.4vw, 40px);
  }
  .lightbox__nav--proximo {
    right: clamp(12px, 2.4vw, 40px);
  }
  @media (max-width: 767px) {
    .lightbox__figura {
      padding-inline: 0;
      padding-bottom: calc(80px + env(safe-area-inset-bottom));
    }
    .lightbox__figura figcaption {
      padding-inline: var(--gutter);
    }
    .lightbox__nav {
      top: auto;
      bottom: max(16px, env(safe-area-inset-bottom));
      margin-top: 0;
      width: 48px;
      height: 48px;
      background: rgb(12 19 38 / 0.6);
    }
  }
</style>
