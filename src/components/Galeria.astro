---
import { Picture } from 'astro:assets';
import { categorias, galeria, indiceDe } from '../data/projetos';

// Só aparecem filtros de ambientes que têm foto.
const filtros = categorias
  .map((c) => ({ ...c, total: galeria.filter((f) => f.categoria === c.id).length }))
  .filter((c) => c.total > 0);
---

<section class="galeria secao" id="ambientes" aria-labelledby="galeria-titulo" data-galeria>
  <div class="container grade cabeca">
    <p class="rotulo" data-revelar="fade">Ambientes</p>
    <h2 id="galeria-titulo" class="titulo" data-revelar="linhas">
      Um portfólio para <strong>cada cômodo da casa.</strong>
    </h2>
  </div>

  <div class="container galeria__corpo">
    <div class="galeria__filtros" role="group" aria-label="Filtrar fotos por ambiente" data-revelar="fade">
      <button type="button" class="galeria__filtro" aria-pressed="true" data-filtro="todos">
        Todos <span>{galeria.length}</span>
      </button>
      {
        filtros.map((c) => (
          <button type="button" class="galeria__filtro" aria-pressed="false" data-filtro={c.id}>
            {c.nome} <span>{c.total}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-galeria-status></p>

    <ul class="galeria__grade" data-galeria-grade data-revelar="fade">
      {
        galeria.map((foto) => (
          <li class:list={['galeria__item', `galeria__item--${foto.formato}`]} data-categoria={foto.categoria}>
            <button
              class="galeria__moldura"
              type="button"
              data-lightbox-abrir={indiceDe(foto)}
              data-lightbox-grupo="galeria"
              data-cursor="Ampliar"
              aria-label={`Ampliar foto: ${foto.legenda}`}
            >
              <span class="galeria__img">
                <Picture
                  src={foto.src}
                  alt={foto.alt}
                  widths={foto.formato === 'retrato' ? [360, 540, 720] : [540, 820, foto.src.width]}
                  sizes={foto.formato !== 'retrato' ? '(min-width: 1024px) 44vw, (min-width: 640px) 66vw, 100vw' : '(min-width: 1024px) 22vw, (min-width: 640px) 33vw, 50vw'}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  quality={74}
                  loading="lazy"
                  style={foto.foco ? `object-position: ${foto.foco}` : undefined}
                />
              </span>
              <span class="galeria__legenda">{foto.legenda}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .galeria {
    padding-top: 0;
  }
  .galeria__filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: clamp(40px, 5vw, 72px) clamp(28px, 3vw, 44px);
  }
  .galeria__filtro {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--tinta-2);
    box-shadow: inset 0 0 0 1px var(--linha);
    transition:
      color var(--t-micro) var(--ease-out),
      background-color var(--t-micro) var(--ease-out),
      box-shadow var(--t-micro) var(--ease-out);
  }
  .galeria__filtro span {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
  @media (hover: hover) {
    .galeria__filtro:hover {
      color: var(--tinta);
      box-shadow: inset 0 0 0 1px var(--linha-forte);
    }
  }
  .galeria__filtro[aria-pressed='true'] {
    background: var(--tinta);
    color: var(--claro);
    box-shadow: none;
  }

  /* Grade de 4 colunas com linhas de altura fixa (proporção 4:5 da coluna, calculada pela largura
     do container): retrato 1x1, paisagem 2x1, destaque 2x2. Tudo alinha, com qualquer filtro. */
  .galeria__corpo {
    container-type: inline-size;
  }
  .galeria__grade {
    --colunas: 4;
    --vao: var(--col-gap);
    display: grid;
    grid-template-columns: repeat(var(--colunas), minmax(0, 1fr));
    grid-auto-rows: calc((100cqi - (var(--colunas) - 1) * var(--vao)) / var(--colunas) * 1.25);
    grid-auto-flow: dense;
    gap: var(--vao);
  }
  .galeria__item[hidden] {
    display: none;
  }
  .galeria__item--paisagem {
    grid-column: span 2;
  }
  .galeria__item--destaque {
    grid-column: span 2;
    grid-row: span 2;
  }

  .galeria__moldura {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--pedra);
    text-align: left;
  }
  .galeria__img,
  .galeria__img :global(picture),
  .galeria__img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .galeria__img :global(img) {
    object-fit: cover;
    transition: transform 1100ms var(--ease-out);
  }

  /* Legenda aparece numa faixa por baixo da foto ao passar o mouse; no toque fica sempre visível. */
  .galeria__legenda {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 40px 16px 14px;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--claro);
    background: linear-gradient(to top, rgb(12 19 38 / 0.72), rgb(12 19 38 / 0));
    transition:
      opacity var(--t-ui) var(--ease-out),
      transform var(--t-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .galeria__legenda {
      opacity: 0;
      transform: translateY(8px);
    }
    .galeria__moldura:hover .galeria__legenda,
    .galeria__moldura:focus-visible .galeria__legenda {
      opacity: 1;
      transform: none;
    }
    .galeria__moldura:hover .galeria__img :global(img) {
      transform: scale(1.04);
    }
  }

  @media (max-width: 1023px) {
    .galeria__grade {
      --colunas: 3;
    }
  }
  @media (max-width: 639px) {
    .galeria__grade {
      --colunas: 2;
      --vao: 8px;
    }
    .galeria__filtros {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .galeria__filtros::-webkit-scrollbar {
      display: none;
    }
    .galeria__filtro {
      flex: none;
    }
    .galeria__legenda {
      padding: 28px 10px 10px;
      font-size: 0.75rem;
    }
  }
</style>
