---
import { Picture } from 'astro:assets';
import { categorias, galeria, indiceDe } from '../data/projetos';

// Só aparecem filtros de ambientes que têm foto.
const filtros = categorias
  .map((c) => ({ ...c, total: galeria.filter((f) => f.categoria === c.id).length }))
  .filter((c) => c.total > 0);
---

<section class="galeria secao" id="ambientes" aria-labelledby="galeria-titulo" data-galeria data-tema="claro">
  <div class="container">
    <header class="galeria__cabeca">
      <h2 id="galeria-titulo" class="titulo" data-revelar="linhas">Cômodo <em>por cômodo.</em></h2>
      <div class="galeria__filtros" role="group" aria-label="Filtrar fotos por ambiente" data-revelar="fade">
        <button type="button" class="galeria__filtro" aria-pressed="true" data-filtro="todos">
          Todos <span>{galeria.length}</span>
        </button>
        {
          filtros.map((c) => (
            <button type="button" class="galeria__filtro" aria-pressed="false" data-filtro={c.id}>
              {c.nome} <span>{c.total}</span>
            </button>
          ))
        }
      </div>
    </header>
    <p class="sr-only" aria-live="polite" data-galeria-status></p>

    <!-- Mural: cada foto mantém a própria proporção. O desenho vem de uma sequência de posições
         aplicada só às fotos visíveis, então vale para qualquer filtro. -->
    <ul class="mural" data-galeria-grade>
      {
        galeria.map((foto, i) => (
          <li class="mural__item" data-categoria={foto.categoria} style={`--vt: foto-${i}`} data-revelar="fade">
            <figure>
              <button
                class="foto"
                type="button"
                style={`aspect-ratio: ${foto.src.width} / ${foto.src.height}`}
                data-lightbox-abrir={indiceDe(foto)}
                data-lightbox-grupo="galeria"
                data-cursor="Ampliar"
                aria-label={`Ampliar foto: ${foto.legenda}`}
              >
                <Picture
                  src={foto.src}
                  alt={foto.alt}
                  widths={[480, 800, foto.src.width]}
                  sizes="(min-width: 1024px) 38vw, (min-width: 640px) 50vw, 92vw"
                  formats={['avif']}
                  fallbackFormat="jpg"
                  quality={68}
                  loading="lazy"
                />
              </button>
              <figcaption class="legenda">{foto.legenda}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .galeria {
    position: relative;
    z-index: 2;
    background: var(--gesso);
  }
  .galeria__cabeca {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }
  .galeria__filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 4px clamp(20px, 2.6vw, 40px);
    padding-top: 14px;
    border-top: 1px solid var(--linha);
  }
  .galeria__filtro {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 44px;
    padding-block: 10px;
    font-size: var(--fs-pequeno);
    color: var(--tinta-2);
    transition: color var(--t-micro) var(--ease-out);
  }
  .galeria__filtro span {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.72;
  }
  .galeria__filtro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: var(--madeira);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 460ms var(--ease-out);
  }
  .galeria__filtro:hover,
  .galeria__filtro[aria-pressed='true'] {
    color: var(--tinta);
  }
  .galeria__filtro[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  /* ---------- mural assimétrico ---------- */
  .mural {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(36px, 4.4vw, 80px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 80px);
  }
  .mural__item {
    view-transition-name: var(--vt);
  }
  .mural__item[hidden] {
    display: none;
  }
  .mural__item :global(.legenda) {
    margin-top: 10px;
  }

  /* Sequência de sete posições: grande, pequena em degrau, pequena recuada, grande, e um trio. */
  .mural__item:nth-child(7n + 1 of :not([hidden])) {
    grid-column: 1 / span 5;
  }
  .mural__item:nth-child(7n + 2 of :not([hidden])) {
    grid-column: 8 / span 4;
    margin-top: clamp(56px, 10vw, 180px);
  }
  .mural__item:nth-child(7n + 3 of :not([hidden])) {
    grid-column: 2 / span 3;
    margin-top: clamp(24px, 4vw, 72px);
  }
  .mural__item:nth-child(7n + 4 of :not([hidden])) {
    grid-column: 6 / span 5;
  }
  .mural__item:nth-child(7n + 5 of :not([hidden])) {
    grid-column: 1 / span 4;
  }
  .mural__item:nth-child(7n + 6 of :not([hidden])) {
    grid-column: 5 / span 3;
    margin-top: clamp(40px, 7vw, 128px);
  }
  .mural__item:nth-child(7n + 7 of :not([hidden])) {
    grid-column: 9 / span 4;
    margin-top: clamp(16px, 3vw, 56px);
  }

  /* ---------- celular: uma foto de borda a borda, depois duas lado a lado, em degrau ---------- */
  @media (max-width: 767px) {
    .galeria__filtros {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .galeria__filtros::-webkit-scrollbar {
      display: none;
    }
    .galeria__filtro {
      flex: none;
    }
    .mural {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
    }
    .mural__item:nth-child(n of :not([hidden])) {
      grid-column: auto;
      margin-top: 0;
    }
    .mural__item:nth-child(3n + 1 of :not([hidden])) {
      grid-column: 1 / -1;
      margin-inline: calc(var(--gutter) * -1);
    }
    .mural__item:nth-child(3n + 1 of :not([hidden])) :global(.legenda) {
      padding-inline: var(--gutter);
    }
    .mural__item:nth-child(3n + 0 of :not([hidden])) {
      margin-top: 40px;
    }
  }
</style>
