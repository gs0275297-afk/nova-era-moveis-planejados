---
import { Picture } from 'astro:assets';
import Icone from './Icone.astro';
import { empresa, mensagemPadrao } from '../data/empresa';
import { abertura } from '../data/projetos';
---

<!-- Abertura: a foto ocupa a parte da tela que a resolução dela comporta (os originais têm 1179 px de
     largura), sem ampliação. No computador, texto à esquerda e foto à direita até a borda; no celular,
     a foto inteira em cima e o texto embaixo. -->
<section class="abertura escuro" id="inicio" aria-labelledby="hero-titulo" data-hero data-tema="escuro">
  <div class="abertura__foto" data-hero-foto>
    <Picture
      src={abertura.src}
      alt={abertura.alt}
      widths={[640, 960, abertura.src.width]}
      sizes="(max-width: 1023px) 100vw, 59vw"
      formats={['avif']}
      fallbackFormat="jpg"
      quality={84}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="abertura__texto" data-hero-texto>
    <h1 id="hero-titulo" class="display" data-hero-titulo>
      Móveis planejados em <em>{empresa.cidade}.</em>
    </h1>
    <div class="abertura__acoes" data-hero-item>
      <a class="botao botao--luz" href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener">
        Solicitar orçamento
        <Icone nome="seta" />
      </a>
      <a class="abertura__continua" href="#nova-era" aria-label="Continuar para a apresentação">
        <i aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<style>
  .abertura {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 41fr) minmax(0, 59fr);
    min-height: max(560px, 100svh);
    background: var(--noite);
  }

  .abertura__foto {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    overflow: hidden;
  }
  .abertura__foto :global(picture),
  .abertura__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .abertura__foto :global(img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: 50% 62%;
  }
  /* só o necessário para ler o menu sobre o forro */
  .abertura__foto::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 22%;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(13 15 20 / 0.55), rgb(13 15 20 / 0));
  }

  .abertura__texto {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    display: grid;
    gap: clamp(28px, 4vh, 48px);
    padding: calc(var(--header-h) + 32px) clamp(28px, 3.4vw, 64px) clamp(32px, 6vh, 72px) var(--gutter);
  }
  .abertura :global(.display) {
    font-size: clamp(2.8rem, 0.9rem + 3.9vw, 6rem);
    line-height: 1;
  }
  .abertura__acoes {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
  }

  /* Indicação de continuidade: um filete de luz que desce. */
  .abertura__continua {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 54px;
  }
  .abertura__continua i {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(246 243 237 / 0.3);
  }
  .abertura__continua i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--luz);
    transform: translateY(-100%);
    animation: descer 2.4s var(--ease-in-out) infinite;
  }
  @keyframes descer {
    55%,
    100% {
      transform: translateY(100%);
    }
  }
  :global(.reduzido) .abertura__continua i::after {
    animation: none;
    transform: none;
  }

  /* celular e tablet: a foto inteira, sem corte, e o texto embaixo */
  @media (max-width: 1023px) {
    .abertura {
      display: block;
      min-height: 0;
    }
    .abertura__foto :global(img) {
      position: static;
      height: auto;
    }
    .abertura__texto {
      padding: 28px var(--gutter) 40px;
    }
  }
  @media (max-width: 767px) {
    .abertura__acoes {
      justify-content: space-between;
    }
    .abertura__acoes .botao {
      flex: 1;
    }
    .abertura__continua {
      flex: none;
    }
  }
</style>
