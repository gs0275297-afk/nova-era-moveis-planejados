---
import { Picture } from 'astro:assets';
import Icone from './Icone.astro';
import { empresa, mensagemPadrao } from '../data/empresa';
import { abertura } from '../data/projetos';
---

<!-- Abertura em tela inteira: o ambiente é o protagonista. Com movimento, a foto fica parada e a
     apresentação sobe por cima dela; sem movimento (ou sem JS), a página apenas segue. -->
<section class="abertura escuro" id="inicio" aria-labelledby="hero-titulo" data-hero data-tema="escuro">
  <div class="abertura__palco">
    <div class="abertura__foto" data-hero-foto>
      <Picture
        src={abertura.src}
        alt={abertura.alt}
        widths={[828, 1280, abertura.src.width]}
        sizes="(max-aspect-ratio: 19/20) 95vh, 100vw"
        formats={['avif']}
        fallbackFormat="jpg"
        quality={74}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="abertura__veu" aria-hidden="true"></div>

    <div class="abertura__base" data-hero-texto>
      <h1 id="hero-titulo" class="display" data-hero-titulo>
        Móveis planejados em <em>{empresa.cidade}.</em>
      </h1>
      <div class="abertura__acoes" data-hero-item>
        <a class="botao botao--luz" href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener">
          Solicitar orçamento
          <Icone nome="seta" />
        </a>
        <a class="abertura__continua" href="#nova-era" aria-label="Continuar para a apresentação">
          <i aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .abertura {
    position: relative;
  }
  .abertura__palco {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--noite);
  }

  /* A foto fica parada enquanto a próxima seção sobe por cima dela. */
  :global(.js-motion:not(.reduzido)) .abertura {
    height: 200svh;
  }
  :global(.js-motion:not(.reduzido)) .abertura__palco {
    position: sticky;
    top: 0;
  }

  .abertura__foto {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .abertura__foto :global(picture),
  .abertura__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Enquadra da linha de luz do forro até a mesa, acima dos pés das cadeiras. */
  .abertura__foto :global(img) {
    object-fit: cover;
    object-position: 50% 68%;
  }

  /* Só o necessário para ler a barra em cima e o título embaixo: o meio da foto fica limpo. */
  .abertura__veu {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(13 15 20 / 0.42) 0%, rgb(13 15 20 / 0) 16%, rgb(13 15 20 / 0) 54%, rgb(13 15 20 / 0.78) 100%);
  }

  .abertura__base {
    position: absolute;
    z-index: 2;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    padding: 0 var(--gutter) clamp(24px, 4.4vh, 48px);
    will-change: transform, opacity;
  }
  .abertura :global(.display) {
    max-width: 10em;
    font-size: clamp(2.8rem, 1rem + 4.4vw, 6.4rem);
    line-height: 1;
    text-shadow: 0 2px 40px rgb(13 15 20 / 0.35);
  }
  .abertura__acoes {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
  }

  /* Indicação de continuidade: um filete de luz que desce. */
  .abertura__continua {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 54px;
  }
  .abertura__continua i {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(246 243 237 / 0.3);
  }
  .abertura__continua i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--luz);
    transform: translateY(-100%);
    animation: descer 2.4s var(--ease-in-out) infinite;
  }
  @keyframes descer {
    55%,
    100% {
      transform: translateY(100%);
    }
  }
  :global(.reduzido) .abertura__continua i::after {
    animation: none;
    transform: none;
  }

  @media (max-width: 767px) {
    .abertura__acoes {
      width: 100%;
      justify-content: space-between;
    }
    .abertura__acoes .botao {
      flex: 1;
    }
    .abertura__continua {
      flex: none;
    }
    .abertura__veu {
      background: linear-gradient(180deg, rgb(13 15 20 / 0.42) 0%, rgb(13 15 20 / 0) 16%, rgb(13 15 20 / 0) 40%, rgb(13 15 20 / 0.82) 100%);
    }
  }
</style>
