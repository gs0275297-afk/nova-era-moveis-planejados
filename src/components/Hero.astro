---
import { Picture } from 'astro:assets';
import Icone from './Icone.astro';
import { empresa, mensagemPadrao } from '../data/empresa';
import { abertura } from '../data/projetos';
---

<!-- Abertura em tela inteira. Com movimento: a seção é mais alta que a janela e a câmera desce do forro
     até a mesa enquanto a pessoa rola; depois, a apresentação sobe por cima da foto parada.
     Sem movimento (ou sem JS): uma tela inteira estática, com a mesma composição. -->
<section class="abertura escuro" id="inicio" aria-labelledby="hero-titulo" data-hero data-tema="escuro">
  <div class="abertura__palco grao" data-hero-palco>
    <div class="abertura__foto" data-hero-foto>
      <div class="abertura__movel" data-hero-movel>
        <Picture
          src={abertura.src}
          alt={abertura.alt}
          widths={[828, 1280, abertura.src.width]}
          sizes="(max-width: 767px) 420px, 100vw"
          formats={['avif']}
          fallbackFormat="jpg"
          quality={62}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="abertura__luz" data-hero-luz aria-hidden="true"></div>
    <div class="abertura__veu" aria-hidden="true"></div>

    <div class="abertura__titulo-bloco" data-hero-texto>
      <p class="abertura__sobre" data-hero-item>
        Móveis planejados <span aria-hidden="true">·</span> <span class="sem-quebra">{empresa.cidade} – {empresa.uf}</span>
      </p>
      <h1 id="hero-titulo" class="display" data-hero-titulo>
        Cada centímetro da sua casa, <em>planejado.</em>
      </h1>
    </div>

    <div class="abertura__base" data-hero-base>
      <p class="abertura__lead" data-hero-item>
        Cozinhas, salas, dormitórios, áreas gourmet e banheiros, fabricados sob medida pela {empresa.nomeCurto}.
      </p>
      <div class="abertura__acoes" data-hero-item>
        <a class="botao botao--luz" href={empresa.whatsapp.link(mensagemPadrao)} target="_blank" rel="noopener" data-magnetico>
          Solicitar orçamento
          <Icone nome="seta" />
        </a>
        <a class="abertura__continua" href="#nova-era" aria-label="Continuar para a apresentação">
          <span>Role</span>
          <i aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <p class="abertura__legenda" data-hero-legenda>{abertura.legenda}. Projeto da {empresa.nomeCurto}.</p>
  </div>
</section>

<style>
  .abertura {
    position: relative;
  }
  .abertura__palco {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: var(--noite);
  }

  /* Três fases na rolagem: a câmera desce (110svh) e a foto fica parada enquanto a próxima seção sobe (100svh). */
  :global(.js-motion:not(.reduzido)) .abertura {
    height: 310svh;
  }
  :global(.js-motion:not(.reduzido)) .abertura__palco {
    position: sticky;
    top: 0;
  }

  .abertura__foto {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .abertura__movel {
    position: absolute;
    top: 0;
    left: -2%;
    width: 104%;
    will-change: transform;
  }
  .abertura__movel :global(picture),
  .abertura__movel :global(img) {
    display: block;
    width: 100%;
  }
  /* A foto é quase quadrada: mais alta que a janela em qualquer tela, é o que dá curso para a câmera. */
  .abertura__movel :global(img) {
    height: max(100vw, 132svh);
    object-fit: cover;
    object-position: 50% 0;
  }
  :global(.reduzido) .abertura__movel :global(img) {
    height: 100svh;
    object-position: 50% 42%;
  }
  :global(html:not(.js-motion)) .abertura__movel :global(img) {
    height: 100svh;
    object-position: 50% 42%;
  }

  /* Luz quente que segue o mouse: só transform, sem repintar a foto. */
  .abertura__luz {
    position: absolute;
    top: 0;
    left: 0;
    width: 70vmax;
    height: 70vmax;
    margin: -35vmax 0 0 -35vmax;
    background: radial-gradient(closest-side, rgb(255 214 160 / 0.2), rgb(255 214 160 / 0.07) 45%, transparent);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms var(--ease-out);
    will-change: transform;
  }
  .abertura__luz.is-acesa {
    opacity: 1;
  }
  @media (hover: none) {
    .abertura__luz {
      display: none;
    }
  }

  .abertura__veu {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(13 15 20 / 0.62) 0%, rgb(13 15 20 / 0.34) 30%, rgb(13 15 20 / 0.06) 56%, rgb(13 15 20 / 0.72) 100%);
  }

  .abertura__titulo-bloco {
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    padding: calc(var(--header-h) + clamp(16px, 4vh, 56px)) var(--gutter) 0;
    will-change: transform, opacity;
  }
  .abertura__sobre {
    margin-bottom: clamp(14px, 2.4vh, 28px);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(246 243 237 / 0.84);
  }
  .abertura :global(.display) {
    max-width: 13.2em;
    text-shadow: 0 2px 40px rgb(13 15 20 / 0.35);
  }

  .abertura__base {
    position: absolute;
    z-index: 2;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    padding: 0 var(--gutter) clamp(20px, 4vh, 44px);
    will-change: transform, opacity;
  }
  .abertura__lead {
    max-width: 30em;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--claro);
    text-wrap: pretty;
  }
  .abertura__acoes {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
  }

  /* Indicação de continuidade: um filete de luz que desce. */
  .abertura__continua {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .abertura__continua i {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(246 243 237 / 0.3);
  }
  .abertura__continua i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--luz);
    transform: translateY(-100%);
    animation: descer 2.4s var(--ease-in-out) infinite;
  }
  @keyframes descer {
    55%,
    100% {
      transform: translateY(100%);
    }
  }
  :global(.reduzido) .abertura__continua i::after {
    animation: none;
    transform: none;
  }

  .abertura__legenda {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: clamp(20px, 4vh, 44px);
    max-width: 30em;
    font-size: 0.875rem;
    color: var(--claro);
    opacity: 0;
    visibility: hidden;
  }

  @media (max-width: 767px) {
    .abertura__acoes {
      width: 100%;
      justify-content: space-between;
    }
    .abertura__acoes .botao {
      flex: 1;
    }
    .abertura__continua {
      flex: none;
    }
    .abertura__continua span {
      display: none;
    }
    .abertura__veu {
      background: linear-gradient(180deg, rgb(13 15 20 / 0.72) 0%, rgb(13 15 20 / 0.42) 34%, rgb(13 15 20 / 0.12) 52%, rgb(13 15 20 / 0.62) 72%, rgb(13 15 20 / 0.9) 100%);
    }
  }
</style>
