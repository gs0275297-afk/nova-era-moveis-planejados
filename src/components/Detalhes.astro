---
import { Picture } from 'astro:assets';
import Icone from './Icone.astro';
import { detalhes } from '../data/projetos';
import type { Detalhe } from '../data/projetos';

const proporcao = (d: Detalhe) => (d.midia.tipo === 'foto' ? d.midia.src.width / d.midia.src.height : d.midia.largura / d.midia.altura);
---

<!-- Close-ups de acabamento, com a mesma lógica de linhas dos projetos. No celular, deslizam para o lado. -->
<section class="detalhes secao escuro" id="detalhes" aria-labelledby="detalhes-titulo" data-tema="escuro">
  <div class="container">
    <h2 id="detalhes-titulo" class="titulo" data-revelar="linhas">Detalhes</h2>
    <div class="detalhes__grade">
      {
        detalhes.map((linha) => (
          <div class="detalhes__linha">
            {linha.map((d) => (
              <figure class="detalhe" style={`--r: ${proporcao(d).toFixed(4)}`} data-revelar="fade">
                <div class="detalhe__midia">
                  {d.midia.tipo === 'foto' ? (
                    <Picture
                      src={d.midia.src}
                      alt={d.midia.alt}
                      widths={[480, d.midia.src.width]}
                      sizes="(min-width: 1024px) 50vw, 90vw"
                      formats={['avif']}
                      fallbackFormat="jpg"
                      quality={74}
                      loading="lazy"
                    />
                  ) : (
                    <>
                      <video
                        muted
                        loop
                        playsinline
                        preload="none"
                        data-poster={`/videos/${d.midia.arquivo}.jpg`}
                        width={d.midia.largura}
                        height={d.midia.altura}
                        aria-label={d.midia.alt}
                        data-video
                      >
                        <source src={`/videos/${d.midia.arquivo}.mp4`} type="video/mp4" />
                      </video>
                      <button class="detalhe__pausa" type="button" data-video-alternar aria-label={`Pausar vídeo: ${d.midia.alt}`}>
                        <Icone nome="pausa" class="detalhe__icone-pausa" />
                        <Icone nome="play" class="detalhe__icone-play" />
                      </button>
                    </>
                  )}
                </div>
                <figcaption>{d.titulo}</figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .detalhes {
    position: relative;
    z-index: 2;
  }
  .detalhes__grade {
    display: grid;
    row-gap: clamp(28px, 3vw, 48px);
    margin-top: clamp(32px, 4vw, 64px);
  }
  .detalhes__linha {
    display: flex;
    gap: var(--col-gap);
  }
  .detalhe {
    flex: var(--r) 1 0;
    min-width: 0;
  }
  .detalhe__midia {
    position: relative;
    aspect-ratio: var(--r);
    overflow: hidden;
    background: var(--noite-2);
  }
  .detalhe__midia :global(picture),
  .detalhe__midia :global(img),
  .detalhe__midia video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detalhe figcaption {
    margin-top: 12px;
    font-size: var(--fs-pequeno);
    color: var(--aluminio);
  }

  .detalhe__pausa {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(13 15 20 / 0.6);
    color: var(--claro);
    box-shadow: inset 0 0 0 1px var(--linha-clara);
  }
  .detalhe__pausa :global(svg) {
    width: 18px;
    height: 18px;
  }
  .detalhe__pausa :global(.detalhe__icone-play),
  .detalhe.is-pausado .detalhe__pausa :global(.detalhe__icone-pausa) {
    display: none;
  }
  .detalhe.is-pausado .detalhe__pausa :global(.detalhe__icone-play) {
    display: block;
  }

  /* celular: mesma altura para todas, deslizando para o lado */
  @media (max-width: 767px) {
    .detalhes__grade {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .detalhes__grade::-webkit-scrollbar {
      display: none;
    }
    .detalhes__linha {
      display: contents;
    }
    .detalhe {
      flex: none;
      width: calc(66vw * var(--r));
      max-width: 88vw;
      scroll-snap-align: start;
    }
  }
</style>
